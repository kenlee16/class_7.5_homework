# Terraform state files — never commit these (contain sensitive resource data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory — contains provider binaries and cached modules
.terraform/
.terraform.lock.hcl

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files (local dev overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files (may contain sensitive values)
*.tfplan
